PORT=4000

# --- Admin dashboard ---
# Password for the private admin dashboard at /admin. Required — the
# server refuses logins if this is unset.
ADMIN_PASSWORD=change-me

# --- AI source discovery agent ---
# Used to evaluate candidate sources found by the discovery agent
# (backend/agent/). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: if set, the agent uses SerpAPI for web search instead of
# DuckDuckGo's free HTML results page. https://serpapi.com/
SERPAPI_KEY=

# --- Scheduling ---
# How often the crawler runs, in hours.
CRAWL_INTERVAL_HOURS=6
# Run all crawlers once on server startup (useful in dev). true | false
CRAWL_ON_START=false
# 24h HH:MM — when the daily source-discovery agent run fires.
AGENT_RUN_TIME=02:00

# --- Push notifications / scoring ---
# Delay applied to push notifications for Free-tier users, in minutes.
FREE_NOTIFICATION_DELAY_MINUTES=30
# Minimum quality score that triggers an immediate push notification.
PUSH_QUALITY_THRESHOLD=70
